    {
      "id": "w9DlaTBZ6fps1tMGYVDV6",
      "type": "text",
      "x": 1218.5395959211364,
      "y": -216.56578840336147,
      "width": 943.8499755859375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
