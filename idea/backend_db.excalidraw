      "index": "ax",
      "roundness": null,
      "seed": 1781728144,
      "version": 882,
      "versionNonce": 1816946032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789477501859,
      "created": 1789476755923,
      "link": null,
      "locked": false,
      "text": "Creating a database that will contain every files who will be shared\nContain 2 table\n    - MANAGER :\n        - Contain the UUID of every manager\n            - Every manager can manage multiple user \n            - User represent by a uuid\n    - USER:\n        - Contain the UUID of every user\n            - User can content\n            - The content can be a documents from docs / mail from Messages or a file from drive\n            ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creating a database that will contain every files who will be shared\nContain 2 table\n    - MANAGER :\n        - Contain the UUID of every manager\n            - Every manager can manage multiple user \n            - User represent by a uuid\n    - USER:\n        - Contain the UUID of every user\n            - User can content\n            - The content can be a documents from docs / mail from Messages or a file from drive\n            ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
