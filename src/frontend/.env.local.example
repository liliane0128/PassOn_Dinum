# Only needed when running this dev server on its own (no nginx in front --
# see the "run without Docker" notes). It bridges this app's relative
# /api/... calls to Django, the way nginx normally does. Point it at wherever
# `manage.py runserver` is listening.
API_PROXY_TARGET=http://localhost:8000

# "true" runs the passation card off a hardcoded fixture instead of the real
# API. See src/backend/.env.example's own copy of this flag for the Docker
# path; this one is what a standalone `npm run dev` reads instead.
NEXT_PUBLIC_DEMO_MODE=false
