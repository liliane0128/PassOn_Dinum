
# Drive's own compose publishes its backend on 8071 (drive/compose.yaml,
# service app-dev). Docs' dev stack defaults to that same port, so if you ever
# run both at once, move one of them and set the URL below accordingly --
# otherwise the Drive calls land on Docs, or the other way round.
DOCS_URL=http://host.docker.internal:8071
DRIVE_URL=http://host.docker.internal:8071
DINUM_API_TIMEOUT=10
DINUM_USE_MOCK=true

# Which upstream services this deployment reads. Leave it out (or list both)
# to read everything. Dropping one -- "drive" alone, where Docs is not
# deployed -- is a configuration change only: the code stays, the service is
# simply never called, and putting the name back restores it at once.
DINUM_ENABLED_SERVICES=docs,drive

# Which fixture DINUM_USE_MOCK serves. Unset/anything else -> the small
# built-in sample (connectors/mock_data.py). "synthetic_handover" -> the
# 13-item, four-project dataset in synthetic_data/ (Camille Faure, mairie de
# Sainte-Radegonde) -- /api/dossier/ completes fine on a free Groq tier with
# this dataset's size. "synthetic_handover_pmr" -> just its 5-item
# accessibilite-pmr project, for a quick single-project spot check. See
# synthetic_data/README.md.
DINUM_MOCK_DATASET=

# ! Required for /api/dossier/ -- get a free key at
# https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ! Required for the postgres database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
