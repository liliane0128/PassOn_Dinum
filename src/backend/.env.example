DOCS_URL=http://host.docker.internal:8071
DRIVE_URL=http://host.docker.internal:8072
MESSAGES_URL=http://host.docker.internal:8901
# Match the cookie name in your Messages deployment (confirmed via
# SESSION_COOKIE_NAME in suitenumerique/messages' settings.py).
MESSAGES_SESSION_COOKIE=st_messages_sessionid
DINUM_API_TIMEOUT=10
DINUM_USE_MOCK=true
# Required for /api/dossier/ -- get a free key at
# https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
